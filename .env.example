# Copy to .env on the host and fill in. Never commit .env.

# Discord bot token (Developer Portal > your application > Bot > Reset Token).
DISCORD_TOKEN=

# Roblox Open Cloud API key (phase 2+): group read + write, data store read/list/delete/create/update and
# Messaging Service publish on the test universe (README: Key permissions).
# The key is IP-restricted on Roblox's side, so it only works on hosts whose IP is allowed.
ROBLOX_API_KEY=

# Optional: register slash commands on start (default 1). Set 0 after the first run to start faster.
SYNC_COMMANDS=1
